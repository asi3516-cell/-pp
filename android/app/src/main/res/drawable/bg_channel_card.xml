<?xml version="1.0" encoding="utf-8"?>
<!-- Channel row card: subtle vertical lift with a hairline, so the rows read
     as tiles against the dark background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient android:startColor="@color/tv_bg_3" android:endColor="@color/tv_bg_2" android:angle="270" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
