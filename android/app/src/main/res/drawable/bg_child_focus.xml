<?xml version="1.0" encoding="utf-8"?>
<!-- Focus/pressed states for a channel row, used by the D-pad on TV boxes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_bg_2" />
            <stroke android:width="2dp" android:color="@color/tv_accent_2" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_bg_3" />
            <stroke android:width="1dp" android:color="@color/tv_line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_bg_2" />
            <stroke android:width="1dp" android:color="@color/tv_line" />
        </shape>
    </item>
</selector>
