<?xml version="1.0" encoding="utf-8"?>
<!-- Player control button that shows an accent ring when a remote highlights it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#22304D" />
            <stroke android:width="2dp" android:color="@color/tv_accent_2" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1E2A42" />
            <stroke android:width="1dp" android:color="#33456B" />
        </shape>
    </item>
</selector>
