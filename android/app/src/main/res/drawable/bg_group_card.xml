<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card behind one category row of the TreeView. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1A3B82F6">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/tv_bg_2" />
            <stroke android:width="1dp" android:color="@color/tv_line" />
        </shape>
    </item>
</ripple>
