<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation bar: lighter than the page with a hairline on top so it
     separates from the scrolling list. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_bg_2" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/tv_line" />
        </shape>
    </item>
</layer-list>
