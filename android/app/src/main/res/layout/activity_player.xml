<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen player. The PlayerView fills the frame; a top scrim holds the back
  button, the channel name and the group name; a bottom scrim holds the
  transport controls and the screen-mode / fullscreen buttons.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="fit" />

    <ProgressBar
        android:id="@+id/playerLoading"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/tv_accent_2"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_player_top"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/playerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/tv_muted"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnResize"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_control_focus"
            android:src="@drawable/ic_resize"
            android:contentDescription="@string/screen_mode" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_control_focus"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="@string/fullscreen" />
    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/playerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_player_bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="26dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/playerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:textColor="@color/tv_muted"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="@string/stream_error" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/tv_muted"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:text="" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:max="1000"
                android:progressTint="@color/tv_accent_2"
                android:progressBackgroundTint="@color/tv_line"
                android:thumbTint="@color/tv_accent_2"
                android:maxHeight="3dp"
                android:minHeight="3dp" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="@color/tv_muted"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:text="" />
        </LinearLayout>

        <!-- Primary transport row: shuffle, previous, play/pause, stop, next,
             repeat. Mirrors the VLC button bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageButton
                android:id="@+id/btnShuffle"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_control_focus"
                android:src="@drawable/ic_shuffle"
                android:contentDescription="@string/shuffle" />

            <ImageButton
                android:id="@+id/btnPrev"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_control_focus"
                android:src="@drawable/ic_prev"
                android:contentDescription="@string/widget_prev" />

            <ImageButton
                android:id="@+id/btnPlay"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_control_accent"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/widget_play" />

            <ImageButton
                android:id="@+id/btnStop"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_focus"
                android:src="@drawable/ic_stop"
                android:contentDescription="@string/stop" />

            <ImageButton
                android:id="@+id/btnNext"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_focus"
                android:src="@drawable/ic_next"
                android:contentDescription="@string/widget_next" />

            <ImageButton
                android:id="@+id/btnRepeat"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_focus"
                android:src="@drawable/ic_repeat"
                android:contentDescription="@string/repeat" />
        </LinearLayout>

        <!-- Secondary row: volume, playlist and speed. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageButton
                android:id="@+id/btnMute"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_volume"
                android:contentDescription="@string/mute" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:max="100"
                android:progressTint="@color/tv_accent_2"
                android:progressBackgroundTint="@color/tv_line"
                android:thumbTint="@color/tv_accent_2"
                android:maxHeight="3dp"
                android:minHeight="3dp" />

            <ImageButton
                android:id="@+id/btnPlaylist"
            android:focusable="true"
            android:focusableInTouchMode="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_playlist"
                android:contentDescription="@string/playlist" />

            <TextView
                android:id="@+id/btnSpeed"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="56dp"
                android:gravity="center"
                android:background="@drawable/bg_control_focus"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/tv_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="1.00x"
                android:contentDescription="@string/speed" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
