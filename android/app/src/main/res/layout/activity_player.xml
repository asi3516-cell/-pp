<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:resize_mode="fit" />

    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:textColor="@color/tv_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:shadowColor="#AA000000"
        android:shadowRadius="6"
        android:shadowDx="0"
        android:shadowDy="1"
        android:text="" />

    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC0B0F19"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/tv_text"
        android:textSize="14sp"
        android:visibility="gone"
        android:text="@string/stream_error" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnResize"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_resize"
            android:contentDescription="@string/screen_mode" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="@string/fullscreen" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_prev"
            android:contentDescription="@string/widget_prev" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_control_accent"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/widget_play" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_control"
            android:src="@drawable/ic_next"
            android:contentDescription="@string/widget_next" />
    </LinearLayout>

</FrameLayout>
