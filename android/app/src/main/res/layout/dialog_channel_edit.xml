<?xml version="1.0" encoding="utf-8"?>
<!-- Add / edit channel dialog. Same dark palette as the list screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tv_bg_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="@string/add_channel" />

        <EditText
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search"
            android:hint="@string/channel_name"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tv_text"
            android:textColorHint="@color/tv_muted"
            android:textSize="15sp"
            android:autofillHints="" />

        <EditText
            android:id="@+id/inputUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search"
            android:hint="@string/channel_address"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tv_text"
            android:textColorHint="@color/tv_muted"
            android:textSize="15sp"
            android:autofillHints="" />

        <EditText
            android:id="@+id/inputGroup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search"
            android:hint="@string/channel_group"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tv_text"
            android:textColorHint="@color/tv_muted"
            android:textSize="15sp"
            android:autofillHints="" />

        <EditText
            android:id="@+id/inputLogo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search"
            android:hint="@string/channel_logo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/tv_text"
            android:textColorHint="@color/tv_muted"
            android:textSize="15sp"
            android:autofillHints="" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tv_danger"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
