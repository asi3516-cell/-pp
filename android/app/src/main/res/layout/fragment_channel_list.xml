<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel list screen. A gradient hero carries the brand, a CANLI badge, the
  live statistics and the search field; a horizontal strip of category chips
  filters the tree below without leaving the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tv_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hero"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_brand_mark">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_brand_tv"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/headerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/tv_text"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/tab_live" />

                    <TextView
                        android:id="@+id/liveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_live_badge"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:text="@string/live" />
                </LinearLayout>

                <TextView
                    android:id="@+id/headerSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#B9C6DD"
                    android:textSize="12.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/hero_tagline" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/addChannel"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat_pill"
                android:src="@drawable/ic_add"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:contentDescription="@string/add_channel" />

            <ImageButton
                android:id="@+id/restoreGroups"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat_pill"
                android:src="@drawable/ic_restore"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:visibility="gone"
                android:contentDescription="@string/hidden_groups_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statChannels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_pill"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="@color/tv_text"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="0 kanal" />

            <TextView
                android:id="@+id/statLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat_pill"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="@color/tv_accent_2"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="0 canlı" />

            <TextView
                android:id="@+id/statFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stat_pill"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="@color/tv_star"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="0 favori" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_modern">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="15dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="43dp"
                android:layout_marginEnd="6dp"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingEnd="8dp"
                android:textColor="@color/tv_text"
                android:textColorHint="@color/tv_muted"
                android:textSize="15sp"
                android:autofillHints="" />

            <ImageButton
                android:id="@+id/searchClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/clear_search" />
        </FrameLayout>

        <TextView
            android:id="@+id/listCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#9FB0CB"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ExpandableListView
            android:id="@+id/expandableList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:groupIndicator="@null"
            android:divider="@null"
            android:childDivider="@null"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:fastScrollEnabled="true"
            android:fastScrollAlwaysVisible="true" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="36dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/emptyIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:alpha="0.55"
                android:src="@drawable/ic_search"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/emptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/tv_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="@string/no_channels" />

            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/tv_muted"
                android:textSize="13sp"
                android:text="" />

            <Button
                android:id="@+id/emptyAddButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_count_pill"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/tv_text"
                android:text="@string/add_channel"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
