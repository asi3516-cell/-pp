<?xml version="1.0" encoding="utf-8"?>
<!-- Channel card for a home rail: logo tile with a live dot, name and meta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="134dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="11dp"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_channel_card"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_logo_tile">

        <TextView
            android:id="@+id/cardInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="T" />

        <ImageView
            android:id="@+id/cardLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <View
            android:id="@+id/cardLiveDot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_live_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/tv_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="TRT 1" />

    <TextView
        android:id="@+id/cardMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_muted"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Ulusal" />

</LinearLayout>
