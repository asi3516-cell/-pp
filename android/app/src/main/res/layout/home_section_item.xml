<?xml version="1.0" encoding="utf-8"?>
<!-- A single category rail: header with the name and count, then the row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="4dp"
            android:layout_height="17dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_group_accent" />

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Canlı TV" />

        <TextView
            android:id="@+id/sectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:gravity="center"
            android:background="@drawable/bg_count_pill"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/tv_accent_2"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:text="0" />

        <TextView
            android:id="@+id/sectionAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_count_pill"
            android:textColor="@color/tv_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:text="@string/see_all" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sectionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:orientation="horizontal" />

</LinearLayout>
