<?xml version="1.0" encoding="utf-8"?>
<!--
  Channel row: a rounded card holding the logo tile (with a live dot for TV),
  the channel name, the category/quality subtitle and the favourite star.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/rowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:clickable="true"
        android:background="@drawable/bg_channel_card"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="13dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_tile">

                <TextView
                    android:id="@+id/childInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="T" />

                <ImageView
                    android:id="@+id/childLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </FrameLayout>

            <View
                android:id="@+id/childLiveDot"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_live_dot" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/childName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="TRT 1" />
        </LinearLayout>

        <TextView
            android:id="@+id/childNowPlaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_count_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/tv_accent_2"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:text="@string/now_playing"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/childFav"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_star_outline"
            android:scaleType="fitCenter"
            android:contentDescription="@string/favourite" />
    </LinearLayout>

</LinearLayout>
