<?xml version="1.0" encoding="utf-8"?>
<!--
  Category (group) row: a rounded card with a gradient accent bar on the left,
  the category name and a count pill; the chevron rotates with the expansion.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/groupCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:clickable="true"
        android:background="@drawable/bg_group_card"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <View
            android:id="@+id/groupAccent"
            android:layout_width="5dp"
            android:layout_height="30dp"
            android:layout_marginEnd="13dp"
            android:background="@drawable/bg_group_accent" />

        <TextView
            android:id="@+id/groupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Spor" />

        <TextView
            android:id="@+id/groupCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:minWidth="30dp"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_count_pill"
            android:textColor="@color/tv_accent_2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="0" />

        <ImageView
            android:id="@+id/groupChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron"
            android:contentDescription="@string/expand_collapse"
            android:tint="@color/tv_muted" />
    </LinearLayout>

</LinearLayout>
