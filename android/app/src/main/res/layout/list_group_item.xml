<?xml version="1.0" encoding="utf-8"?>
<!--
  Category (group) row of the channel TreeView, drawn as a rounded card.
  Left: a coloured accent bar. Centre: category name and a live count hint.
  Right: the chevron the adapter rotates in step with the expand animation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_group_card"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <View
            android:id="@+id/groupAccent"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_group_accent" />

        <TextView
            android:id="@+id/groupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Spor" />

        <TextView
            android:id="@+id/groupCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:minWidth="30dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_count_pill"
            android:textColor="@color/tv_accent_2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="0" />

        <ImageView
            android:id="@+id/groupChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_chevron"
            android:contentDescription="@string/expand_collapse"
            android:tint="@color/tv_muted" />
    </LinearLayout>

</LinearLayout>
