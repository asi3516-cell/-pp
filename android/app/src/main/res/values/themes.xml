<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="colorPrimary">@color/tv_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/tv_accent_2</item>
        <item name="colorSurface">@color/tv_bg_2</item>
        <item name="colorOnSurface">@color/tv_text</item>
        <item name="android:statusBarColor">@color/tv_bg</item>
        <item name="android:navigationBarColor">@color/tv_bg_2</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TVPlayer.Player" parent="Theme.TVPlayer">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Draw edge to edge, including under the display cutout, so no black
             strip is left on the notch side in landscape. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="NavItemIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/tv_accent_soft</item>
    </style>
</resources>
